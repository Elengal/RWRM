<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>r_name->[creepjoinerFirstname] [creepjoinerLastname]</li>
    <li>r_name->[creepjoinerFirstname] '[creepjoinerNickname]' [creepjoinerLastname]</li>
  -->
  <NamerPersonCreepjoiner.rulePack.rulesStrings>
    <li>r_name->[creepjoinerFirstname] [creepjoinerLastname]</li>
    <li>r_name->[creepjoinerFirstname] [creepjoinerLastname] ([creepjoinerNickname])</li>
  </NamerPersonCreepjoiner.rulePack.rulesStrings>

  <!--
    Ссылки на файлы слов надо перенаправлять: ваниль просит Names/Creepjoiner_Last,
    а наши файлы названы с суффиксом источника. Ключ в LoadedLanguage.stringFiles —
    точное имя файла, поэтому без этого блока игра молча берёт английский список.
  -->
  <NamerPersonCreepjoiner.rulePack.rulesFiles>
    <li>creepjoinerLastname->Names/Creepjoiner_Last_Anomaly</li>
    <li>creepjoinerNickname->Names/Creepjoiner_Nick_Anomaly</li>
  </NamerPersonCreepjoiner.rulePack.rulesFiles>
  
</LanguageData>